{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chenxiachan/thoughtdag/protocol/context-bundle/v0/schema.json",
  "title": "ThoughtDAG Context Bundle v0",
  "description": "PROPOSAL — unstable until fixtures freeze it. The compiled, portable expression of what a target model should see next, with per-item provenance back to the Context Graph. Deterministic: the same graph snapshot with the same compile options produces byte-identical output (volatile fields are injected; the id derives from the content hash).",
  "type": "object",
  "required": ["format", "version", "id", "created_at", "graph", "intent", "context", "execution_hints", "budget", "provenance", "integrity"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "thoughtdag.context-bundle" },
    "version": { "const": 0 },
    "id": { "type": "string", "pattern": "^cb_[0-9a-f]{16}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "graph": {
      "type": "object",
      "required": ["project_id", "snapshot_hash", "target_node_id"],
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": ["string", "null"] },
        "snapshot_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "target_node_id": { "type": "string" }
      }
    },
    "intent": {
      "type": "object",
      "required": ["task", "language"],
      "additionalProperties": false,
      "properties": {
        "task": { "type": "string" },
        "language": { "type": ["string", "null"] }
      }
    },
    "context": {
      "type": "object",
      "required": ["messages", "materials", "references"],
      "additionalProperties": false,
      "properties": {
        "messages": { "type": "array", "items": { "$ref": "#/$defs/messageItem" } },
        "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_node_id"],
            "additionalProperties": false,
            "properties": { "source_node_id": { "type": "string" } }
          }
        }
      }
    },
    "execution_hints": {
      "type": "object",
      "required": ["preferred_model", "required_tools", "required_mcp_servers"],
      "additionalProperties": false,
      "properties": {
        "preferred_model": { "type": ["string", "null"] },
        "required_tools": { "type": "array", "items": { "type": "string" } },
        "required_mcp_servers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "required": ["estimated_tokens", "limit", "truncation"],
      "additionalProperties": false,
      "properties": {
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "limit": { "type": ["integer", "null"] },
        "truncation": { "const": "none" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_runs", "compiler"],
      "additionalProperties": false,
      "properties": {
        "source_runs": { "type": "array", "items": { "type": "string" } },
        "compiler": {
          "type": "object",
          "required": ["name", "adapter_id"],
          "additionalProperties": false,
          "properties": {
            "name": { "const": "thoughtdag" },
            "adapter_id": { "type": ["string", "null"] }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["content_hash"],
      "additionalProperties": false,
      "properties": {
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "messageItem": {
      "type": "object",
      "required": ["id", "kind", "role", "content", "source", "selection"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^item_[0-9]{3,}$" },
        "kind": { "const": "message" },
        "role": { "enum": ["system", "user", "assistant"] },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "text"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "text" },
              "text": { "type": "string" }
            }
          }
        },
        "source": {
          "type": "object",
          "required": ["layer"],
          "additionalProperties": false,
          "properties": {
            "layer": { "enum": ["system", "material", "reference", "chain", "branch"] },
            "part": { "enum": ["role", "attachment", "question", "response", "reference", "passage"] },
            "node_id": { "type": "string" },
            "attachment_id": { "type": "string" }
          }
        },
        "selection": {
          "type": "object",
          "required": ["mode", "reason"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "full" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "material": {
      "type": "object",
      "required": ["id", "kind", "name", "mime_type", "size", "fingerprint", "model_projection", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["image", "document"] },
        "name": { "type": "string" },
        "mime_type": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "fingerprint": { "type": "string" },
        "model_projection": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["extracted_text", "pixels", "extracted_text+pixels", "placeholder"] }
          }
        },
        "source": {
          "type": "object",
          "required": ["node_id"],
          "additionalProperties": false,
          "properties": { "node_id": { "type": "string" } }
        }
      }
    }
  }
}
