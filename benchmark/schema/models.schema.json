{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "thoughtdag-benchmark-models",
  "type": "object",
  "required": [
    "panel"
  ],
  "properties": {
    "panel": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "model",
          "lane"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "Verify against the provider's official model list before each run"
          },
          "lane": {
            "enum": [
              "standard",
              "reasoning",
              "both"
            ]
          },
          "decoding": {
            "type": "object"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
