{
  "name": "thoughtdag",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "desktop": "npm run build && cd desktop && electron .",
    "cli:build": "esbuild cli/src/main.ts --bundle --platform=node --format=esm --target=node20 --define:import.meta.env={} --outfile=cli/dist/thoughtdag.mjs --log-level=warning"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/deepseek": "^3.0.5",
    "@ai-sdk/google": "^4.0.8",
    "@ai-sdk/mcp": "^2.0.7",
    "@ai-sdk/openai": "^4.0.7",
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@tailwindcss/vite": "^4.1.18",
    "@xyflow/react": "^12.10.0",
    "ai": "^7.0.15",
    "cors": "^2.8.6",
    "defuddle": "^0.19.2",
    "dompurify": "^3.4.13",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.6",
    "katex": "^0.16.28",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.4",
    "zhipu-ai-provider": "^0.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright-core": "^1.61.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitepress": "^1.6.4"
  },
  "description": "An infinite canvas where LLM conversations grow into an editable thought graph. Read papers into maps; every answer knows where it came from.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenxiachan/thoughtdag.git"
  },
  "keywords": [
    "llm",
    "dag",
    "canvas",
    "react-flow",
    "ai",
    "knowledge-graph",
    "research-tool"
  ],
  "license": "MIT"
}
