{
  "name": "thoughtdag-desktop",
  "private": true,
  "version": "0.4.3",
  "description": "Desktop shell for ThoughtDAG — same app, same server, one window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "payload": "node scripts/prepare-payload.mjs",
    "dist:mac": "npm run payload && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:win": "npm run payload && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run payload && electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.chenxiachan.thoughtdag",
    "productName": "ThoughtDAG",
    "protocols": [
      { "name": "ThoughtDAG", "schemes": ["thoughtdag"] }
    ],
    "icon": "build/icon.png",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "chenxiachan",
      "repo": "thoughtdag"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}