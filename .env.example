# At least one LLM key is required. 至少填一把 key。

# 智谱 GLM (free tier: glm-4.5-flash / glm-4v-flash) — https://open.bigmodel.cn/
ZHIPU_API_KEY=

# 通义千问 DashScope (paid) — https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# Port for the LLM proxy server (frontend expects 3001 unless VITE_API_BASE is set)
PORT=3001
