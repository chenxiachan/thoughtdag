# At least one LLM key is required — every provider below registers
# automatically when its key is present. 至少填一把 key，填了即自动注册。

# ─── Free tier / 免费档 ────────────────────────────────────────────
# 智谱 GLM (free: glm-4.5-flash / glm-4v-flash; web search ~¥0.01/query)
# https://open.bigmodel.cn/
ZHIPU_API_KEY=

# ─── Cloud providers / 云端模型 ────────────────────────────────────
# 通义千问 DashScope — https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# OpenAI — https://platform.openai.com/
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5.1,gpt-5-mini        # optional override, comma-separated

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-sonnet-5,claude-haiku-4-5

# Google Gemini — https://aistudio.google.com/
GOOGLE_API_KEY=
# GOOGLE_MODELS=gemini-2.5-pro,gemini-2.5-flash

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# OpenRouter (gateway to 300+ models) — https://openrouter.ai/
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=openrouter/auto,moonshotai/kimi-k2

# ─── Local / 本地 ──────────────────────────────────────────────────
# Ollama: list the local models to expose (registers only when set)
# OLLAMA_MODELS=qwen3:8b,llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# Port for the LLM proxy server (frontend expects 3001 unless VITE_API_BASE is set)
PORT=3001
