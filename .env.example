# ─────────────────────────────────────────────────────────────────────
# ThoughtDAG configuration template
#
#   cp .env.example .env       ← your real keys live in .env (gitignored,
#                                 never commit it; this template is safe
#                                 to share)
#
# At least ONE key below is required. Every provider registers
# automatically when its key is present: no code changes, no config files.
# Restart `npm run server` after editing.
#
# Image understanding (auto-reading of pasted images and the reader's
# per-page Recognize) needs at least one VISION-capable model. The free
# glm-4v-flash qualifies; flagship vision models read scientific figures
# noticeably better and are picked automatically when present.
# ─────────────────────────────────────────────────────────────────────

# ─── Free tier ───────────────────────────────────────────────────────
# Zhipu GLM (free: glm-4.5-flash text + glm-4v-flash vision; also powers
# agentic web search, ~¥0.01/query) — https://open.bigmodel.cn/
ZHIPU_API_KEY=
# ZHIPU_MODELS=glm-5,glm-4.6,glm-4v-flash      # paid tiers, once topped up

# Web search quality (optional):
# ZHIPU_SEARCH_ENGINE=search_pro               # better sources, ~3x price of search_std

# AnySearch (optional): web search runs keyless on its anonymous per-IP
# tier when no GLM key is set; a free-signup key lifts the daily quota.
# ANYSEARCH_API_KEY=
# SEARCH_BLOCK_DOMAINS=example.com,another.com # extra domains to filter from results
# (document-farm / Q&A-farm domains are filtered by default)

# ─── Cloud providers ─────────────────────────────────────────────────
# Qwen via DashScope (Alibaba Model Studio) — https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# DASHSCOPE_MODELS=qwen3.7-max,qwen-plus

# OpenAI — https://platform.openai.com/
OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5.5,gpt-5-mini

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-sonnet-5,claude-haiku-4-5

# Google Gemini — https://aistudio.google.com/
GOOGLE_API_KEY=
# GOOGLE_MODELS=gemini-3.1-pro-preview,gemini-3.5-flash

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Kimi / Moonshot — https://platform.moonshot.cn/
# (international accounts: set MOONSHOT_BASE_URL=https://api.moonshot.ai/v1)
MOONSHOT_API_KEY=
# MOONSHOT_MODELS=kimi-k2.6,kimi-latest

# ─── One key for everything ──────────────────────────────────────────
# OpenRouter routes 300+ models behind a single key — https://openrouter.ai/keys
# List any vendor/model slugs from https://openrouter.ai/models
# (vision capability is detected automatically from OpenRouter metadata).
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=openrouter/auto,deepseek/deepseek-v4-pro,moonshotai/kimi-k2.6,z-ai/glm-5,qwen/qwen3.7-max,google/gemini-3.1-pro-preview,openai/gpt-5.5,anthropic/claude-sonnet-5,minimax/minimax-m3

# ─── Local ───────────────────────────────────────────────────────────
# Ollama: list the local models to expose (registers only when set)
# OLLAMA_MODELS=qwen3:8b,llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Server ──────────────────────────────────────────────────────────
# Output ceiling per generation. OpenRouter pre-authorizes the requested
# max_tokens against your balance, so keep this modest on small credits.
# MAX_OUTPUT_TOKENS=16384

# Port for the LLM proxy (frontend expects 3001 unless VITE_API_BASE is set)
PORT=3001
